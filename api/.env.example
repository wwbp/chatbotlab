# Django admin superuser (used by `make superuser` locally; set in EB env vars for deployed environments)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme

# Django
DEBUG=True
SECRET_KEY=your_django_secret_key_here_min_50_chars
BACKEND_ENVIRONMENT=local

# Database (Django connection)
DATABASE_NAME=chatbot_db
DATABASE_USER=your_mysql_user
DATABASE_PASSWORD=your_mysql_password
DATABASE_HOST=db
DATABASE_PORT=3306

# MariaDB container (used by docker compose db service)
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=chatbot_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_URL=redis://redis:6379

# LLM API keys (at least one required)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Optional: allow a custom frontend origin (e.g. for embedded deployments)
# FRONTEND_URL=https://your-frontend-domain.com

# Optional: AWS S3 (for avatar/voice file storage — required in production)
# AWS_BUCKET_NAME=your_aws_bucket_name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# App
CHATBOT_CONTROL_IMAGE=https://example.com/control-image.png
CHATBOT_AVATAR_PROMPT=Create a professional avatar for a chatbot

# ── Load testing / performance ───────────────────────────────────────────────
# MOCK_LLM=true skips real LLM + moderation API calls and simulates latency
# locally. Set on the server (or EB env vars) before running locust.
# Run `python bench_latency.py` first to calibrate the P50 values below.
MOCK_LLM=false
MOCK_LLM_P50_MS=900
MOCK_MODERATION_P50_MS=220

# Gunicorn worker count (production). Default=4; set to 2×vCPU on EC2.
# GUNICORN_WORKERS=4

# DB connection reuse (seconds). Django 5.x ASGI-safe with sync_to_async.
# CONN_MAX_AGE=60

# ── Survey context ───────────────────────────────────────────────────────────
# Shared secret the survey tool (e.g. a Qualtrics Web Service element) sends as
# the X-Survey-Token header when POSTing participant answers to
# /api/survey_response/. Unset means the endpoint rejects every request, which
# is the right default for studies that do not feed survey answers to the bot.
# Generate one with: openssl rand -hex 32
# SURVEY_INGEST_TOKEN=
