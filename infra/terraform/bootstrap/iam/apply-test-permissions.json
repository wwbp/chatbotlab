{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>"
    },
    {
      "Sid": "ReadWriteOwnStateAndLock",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>/<PREFIX>/test/*"
    },
    {
      "Sid": "ManageOwnBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::<PREFIX>-test-*"
    },
    {
      "Sid": "ElasticBeanstalkBucketLevel",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::elasticbeanstalk-*-<ACCOUNT_ID>"
    },
    {
      "Sid": "ElasticBeanstalkOwnApplicationKeys",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::elasticbeanstalk-*/<PREFIX>-test/*"
    },
    {
      "Sid": "ManageOwnDatabase",
      "Effect": "Allow",
      "Action": "rds:*",
      "Resource": [
        "arn:aws:rds:*:<ACCOUNT_ID>:*:<PREFIX>-test-*",
        "arn:aws:rds:*:<ACCOUNT_ID>:og:default:*"
      ]
    },
    {
      "Sid": "ManageOwnCache",
      "Effect": "Allow",
      "Action": "elasticache:*",
      "Resource": "arn:aws:elasticache:*:<ACCOUNT_ID>:serverlesscache:<PREFIX>-test-*"
    },
    {
      "Sid": "ManageOwnElasticBeanstalk",
      "Effect": "Allow",
      "Action": "elasticbeanstalk:*",
      "Resource": [
        "arn:aws:elasticbeanstalk:*:*:application/<PREFIX>-test",
        "arn:aws:elasticbeanstalk:*:<ACCOUNT_ID>:*/<PREFIX>-test/*",
        "arn:aws:elasticbeanstalk:*::solutionstack/*",
        "arn:aws:elasticbeanstalk:*::platform/*"
      ]
    },
    {
      "Sid": "ManageOwnLogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:*:<ACCOUNT_ID>:log-group:/aws/elasticbeanstalk/<PREFIX>-test-*"
    },
    {
      "Sid": "OwnDnsRecords",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/<ZONE_ID>",
      "Condition": {
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "<PREFIX>-test-origin.<ZONE_NAME>",
            "_????????????????????????????????.<PREFIX>-test-origin.<ZONE_NAME>"
          ]
        },
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "A",
            "AAAA",
            "CNAME"
          ]
        }
      }
    },
    {
      "Sid": "DenyDottedValidationNames",
      "Effect": "Deny",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/<ZONE_ID>",
      "Condition": {
        "ForAnyValue:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "_*.*.<PREFIX>-test-origin.<ZONE_NAME>"
          ]
        }
      }
    },
    {
      "Sid": "OwnWebAcl",
      "Effect": "Allow",
      "Action": [
        "wafv2:CreateWebACL",
        "wafv2:DeleteWebACL",
        "wafv2:GetWebACL",
        "wafv2:ListTagsForResource",
        "wafv2:TagResource",
        "wafv2:UntagResource",
        "wafv2:UpdateWebACL"
      ],
      "Resource": [
        "arn:aws:wafv2:us-east-1:<ACCOUNT_ID>:global/webacl/<PREFIX>-test-*/*",
        "arn:aws:wafv2:us-east-1:<ACCOUNT_ID>:global/managedruleset/*/*"
      ]
    },
    {
      "Sid": "ReadEverythingElse",
      "Effect": "Allow",
      "Action": [
        "acm:Describe*",
        "acm:List*",
        "autoscaling:Describe*",
        "cloudfront:List*",
        "ec2:Describe*",
        "elasticache:Describe*",
        "elasticache:ListTagsForResource",
        "elasticbeanstalk:DescribeA*",
        "elasticbeanstalk:DescribeE*",
        "elasticbeanstalk:DescribeI*",
        "elasticbeanstalk:DescribeP*",
        "elasticbeanstalk:List*",
        "elasticloadbalancing:Describe*",
        "iam:Get*",
        "iam:List*",
        "logs:Describe*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "route53:Get*",
        "route53:List*",
        "s3:ListAllMyBuckets",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ChangeOwnRolesOnlyUnderBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<PREFIX>-test-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/<PREFIX>-terraform-boundary-test"
        }
      }
    },
    {
      "Sid": "ManageOwnRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<PREFIX>-test-*"
    },
    {
      "Sid": "AttachOnlyElasticBeanstalkManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<PREFIX>-test-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/AWSElasticBeanstalkWebTier",
            "arn:aws:iam::aws:policy/AdministratorAccess-AWSElasticBeanstalk",
            "arn:aws:iam::aws:policy/AWSElasticBeanstalkManagedUpdatesCustomerRolePolicy",
            "arn:aws:iam::aws:policy/service-role/AWSElasticBeanstalkEnhancedHealth"
          ]
        },
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<ACCOUNT_ID>:policy/<PREFIX>-terraform-boundary-test"
        }
      }
    },
    {
      "Sid": "ManageOwnInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:AddRoleToInstanceProfile",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:instance-profile/<PREFIX>-test-*"
    },
    {
      "Sid": "PassOwnRolesToElasticBeanstalkAndEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<PREFIX>-test-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "elasticbeanstalk.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/*"
    }
  ]
}
