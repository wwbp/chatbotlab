{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:CreateAutoScalingGroup",
        "cloudformation:CreateStack",
        "ec2:AllocateAddress",
        "ec2:CreateLaunchTemplate",
        "ec2:CreateNetworkInterface",
        "ec2:CreateSecurityGroup",
        "ec2:RunInstances",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:CreateTargetGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "test",
          "aws:RequestTag/Project": "<PREFIX>"
        },
        "ForAllValues:StringLike": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Name",
            "Project",
            "Purpose",
            "Tier",
            "aws:cloudformation:*",
            "elasticbeanstalk:*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:Attach*",
        "autoscaling:Delete*",
        "autoscaling:Detach*",
        "autoscaling:Put*",
        "autoscaling:Resume*",
        "autoscaling:Set*",
        "autoscaling:Suspend*",
        "autoscaling:Terminate*",
        "autoscaling:Update*",
        "cloudformation:CancelUpdateStack",
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:Delete*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:SignalResource",
        "cloudformation:Update*",
        "cloudfront:CreateInvalidation",
        "ec2:Associate*",
        "ec2:Attach*",
        "ec2:Authorize*",
        "ec2:CreateRoute",
        "ec2:Delete*",
        "ec2:Detach*",
        "ec2:Disassociate*",
        "ec2:Modify*",
        "ec2:Revoke*",
        "ec2:Terminate*",
        "elasticloadbalancing:Delete*",
        "elasticloadbalancing:Deregister*",
        "elasticloadbalancing:Modify*",
        "elasticloadbalancing:Register*",
        "elasticloadbalancing:Remove*",
        "elasticloadbalancing:Set*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "test",
          "aws:ResourceTag/Project": "<PREFIX>"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "test",
          "aws:RequestTag/Project": "<PREFIX>"
        },
        "StringLike": {
          "ec2:CreateAction": [
            "AllocateAddress",
            "Create*",
            "RunInstances"
          ]
        },
        "ForAllValues:StringLike": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Name",
            "Project",
            "Purpose",
            "Tier",
            "aws:cloudformation:*",
            "elasticbeanstalk:*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "elasticloadbalancing:AddTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "test",
          "aws:RequestTag/Project": "<PREFIX>"
        },
        "StringLike": {
          "elasticloadbalancing:CreateAction": "Create*"
        },
        "ForAllValues:StringLike": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Name",
            "Project",
            "Purpose",
            "Tier",
            "aws:cloudformation:*",
            "elasticbeanstalk:*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*::snapshot/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:Owner": "amazon"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:network-interface/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:volume/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:launch-template/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<PREFIX>-test-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "elasticbeanstalk.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:*",
        "logs:CreateLog*",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents",
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:elasticbeanstalk:*:*:application/<PREFIX>-test",
        "arn:aws:elasticbeanstalk:*:<ACCOUNT_ID>:*/<PREFIX>-test/*",
        "arn:aws:elasticbeanstalk:*::solutionstack/*",
        "arn:aws:elasticbeanstalk:*::platform/*",
        "arn:aws:s3:::<PREFIX>-test-*",
        "arn:aws:s3:::elasticbeanstalk-*/<PREFIX>-test/*",
        "arn:aws:s3:::elasticbeanstalk-*-<ACCOUNT_ID>",
        "arn:aws:logs:*:<ACCOUNT_ID>:log-group:/aws/elasticbeanstalk/<PREFIX>-test-*",
        "arn:aws:secretsmanager:*:<ACCOUNT_ID>:secret:<PREFIX>-test/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:*:*:secret:rds!db-*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/aws:rds:primaryDBInstanceArn": "arn:aws:rds:*:<ACCOUNT_ID>:db:<PREFIX>-test-*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:Describe*",
        "bedrock:Converse*",
        "bedrock:InvokeModel*",
        "cloudwatch:PutMetricData",
        "ec2:Describe*",
        "elasticache:Describe*",
        "elasticbeanstalk:DescribeA*",
        "elasticbeanstalk:DescribeE*",
        "elasticbeanstalk:DescribeI*",
        "elasticbeanstalk:DescribeP*",
        "elasticbeanstalk:List*",
        "elasticloadbalancing:Describe*",
        "rds:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyState",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>",
        "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>/*"
      ]
    },
    {
      "Sid": "DenyHandBuiltLiveDeployment",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:elasticbeanstalk:*:*:*/humanlikebot",
        "arn:aws:elasticbeanstalk:*:*:*/humanlikebot/*",
        "arn:aws:rds:*:*:*:awseb-e-*",
        "arn:aws:cloudfront::*:distribution/E2Q6P4TGU4GOC",
        "arn:aws:cloudfront::*:distribution/E2XKRGQ6R0OG6W",
        "arn:aws:s3:::elasticbeanstalk-*/humanlikebot/*",
        "arn:aws:s3:::bot.wwbp.org*",
        "arn:aws:s3:::dev.bot.wwbp.org*",
        "arn:aws:s3:::bot-avatar.wwbp.org*",
        "arn:aws:s3:::dev.bot-avatar.wwbp.org*"
      ]
    },
    {
      "Sid": "DenyHandBuiltLiveEnvironmentResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/elasticbeanstalk:environment-name": [
            "humanlike-bot-development-env",
            "humanlikebot-env"
          ]
        }
      }
    },
    {
      "Sid": "DenyOidcProviderChanges",
      "Effect": "Deny",
      "Action": "iam:*OpenIDConnectProvider*",
      "Resource": "*"
    },
    {
      "Sid": "DenySendingEmail",
      "Effect": "Deny",
      "Action": "ses:Send*",
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherEnvNames",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "arn:aws:*<PREFIX>-production*"
    },
    {
      "Sid": "DenyOtherEnvTags",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "production"
        }
      }
    }
  ]
}
