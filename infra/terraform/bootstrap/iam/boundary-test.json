{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:CreateAutoScalingGroup",
        "cloudformation:CreateStack",
        "ec2:AllocateAddress",
        "ec2:CreateInternetGateway",
        "ec2:CreateLaunchTemplate",
        "ec2:CreateNetworkInterface",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateSubnet",
        "ec2:CreateVolume",
        "ec2:CreateVpc",
        "ec2:RunInstances",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:CreateTargetGroup"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "test",
          "aws:RequestTag/Project": "<PREFIX>"
        },
        "ForAllValues:StringLike": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Name",
            "Project",
            "Purpose",
            "Tier",
            "aws:cloudformation:*",
            "elasticbeanstalk:*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:Attach*",
        "autoscaling:Delete*",
        "autoscaling:Detach*",
        "autoscaling:Put*",
        "autoscaling:Resume*",
        "autoscaling:Set*",
        "autoscaling:Suspend*",
        "autoscaling:Terminate*",
        "autoscaling:Update*",
        "cloudformation:CancelUpdateStack",
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:Delete*",
        "cloudformation:SignalResource",
        "cloudformation:Update*",
        "cloudfront:CreateInvalidation",
        "ec2:Associate*",
        "ec2:Attach*",
        "ec2:Authorize*",
        "ec2:CreateRoute",
        "ec2:Delete*",
        "ec2:Detach*",
        "ec2:Disassociate*",
        "ec2:Modify*",
        "ec2:Revoke*",
        "ec2:Terminate*",
        "elasticloadbalancing:Delete*",
        "elasticloadbalancing:Deregister*",
        "elasticloadbalancing:Modify*",
        "elasticloadbalancing:Register*",
        "elasticloadbalancing:Remove*",
        "elasticloadbalancing:Set*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "test",
          "aws:ResourceTag/Project": "<PREFIX>"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "test",
          "aws:RequestTag/Project": "<PREFIX>"
        },
        "StringLike": {
          "ec2:CreateAction": [
            "AllocateAddress",
            "Create*",
            "RunInstances"
          ]
        },
        "ForAllValues:StringLike": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Name",
            "Project",
            "Purpose",
            "Tier",
            "aws:cloudformation:*",
            "elasticbeanstalk:*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "elasticloadbalancing:AddTags",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "test",
          "aws:RequestTag/Project": "<PREFIX>"
        },
        "StringLike": {
          "elasticloadbalancing:CreateAction": "Create*"
        },
        "ForAllValues:StringLike": {
          "aws:TagKeys": [
            "Environment",
            "ManagedBy",
            "Name",
            "Project",
            "Purpose",
            "Tier",
            "aws:cloudformation:*",
            "elasticbeanstalk:*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:*::image/*",
        "arn:aws:ec2:*::snapshot/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:network-interface/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:volume/*",
        "arn:aws:ec2:*:<ACCOUNT_ID>:launch-template/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "elasticbeanstalk:*",
      "Resource": [
        "arn:aws:elasticbeanstalk:*:<ACCOUNT_ID>:*/<PREFIX>-test",
        "arn:aws:elasticbeanstalk:*:<ACCOUNT_ID>:*/<PREFIX>-test/*",
        "arn:aws:elasticbeanstalk:*::solutionstack/*",
        "arn:aws:elasticbeanstalk:*::platform/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<PREFIX>-test-*",
        "arn:aws:s3:::elasticbeanstalk-*/<PREFIX>-test/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::elasticbeanstalk-*-<ACCOUNT_ID>"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLog*",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:<ACCOUNT_ID>:log-group:/aws/elasticbeanstalk/<PREFIX>-test-*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData",
        "xray:GetSampling*",
        "xray:PutTelemetryRecords",
        "xray:PutTraceSegments"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:*:<ACCOUNT_ID>:parameter/<PREFIX>-test/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "bedrock:Converse*",
        "bedrock:InvokeModel*",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetAuthorizationToken",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:Describe*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "ec2:Describe*",
        "elasticache:Describe*",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*",
        "elasticloadbalancing:Describe*",
        "rds:Describe*",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<PREFIX>-test-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "elasticbeanstalk.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyState",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>",
        "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>/*"
      ]
    },
    {
      "Sid": "DenyHandBuiltLiveDeployment",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:elasticbeanstalk:*:*:*/humanlikebot",
        "arn:aws:elasticbeanstalk:*:*:*/humanlikebot/*",
        "arn:aws:rds:*:*:*:awseb-e-*",
        "arn:aws:cloudfront::*:distribution/E2Q6P4TGU4GOC",
        "arn:aws:cloudfront::*:distribution/E2XKRGQ6R0OG6W",
        "arn:aws:s3:::elasticbeanstalk-*/humanlikebot/*",
        "arn:aws:s3:::bot.wwbp.org*",
        "arn:aws:s3:::dev.bot.wwbp.org*",
        "arn:aws:s3:::bot-avatar.wwbp.org*",
        "arn:aws:s3:::dev.bot-avatar.wwbp.org*"
      ]
    },
    {
      "Sid": "DenyHandBuiltLiveEnvironmentResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/elasticbeanstalk:environment-name": [
            "humanlike-bot-development-env",
            "humanlikebot-env"
          ]
        }
      }
    },
    {
      "Sid": "DenyOidcProviderChanges",
      "Effect": "Deny",
      "Action": "iam:*OpenIDConnectProvider*",
      "Resource": "*"
    },
    {
      "Sid": "DenySendingEmail",
      "Effect": "Deny",
      "Action": "ses:Send*",
      "Resource": "*"
    }
  ]
}
