{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>"
    },
    {
      "Sid": "ReadStateFiles",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>/<PREFIX>/staging/terraform.tfstate",
        "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>/<PREFIX>/production/terraform.tfstate"
      ]
    },
    {
      "Sid": "ReadStackBucketSettings",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetAccelerateConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::<PREFIX>-staging-*",
        "arn:aws:s3:::<PREFIX>-production-*"
      ]
    },
    {
      "Sid": "DescribeStackResources",
      "Effect": "Allow",
      "Action": [
        "acm:Describe*",
        "acm:List*",
        "autoscaling:Describe*",
        "cloudformation:Describe*",
        "cloudformation:Get*",
        "cloudformation:List*",
        "cloudfront:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "ec2:Describe*",
        "elasticache:Describe*",
        "elasticache:ListTagsForResource",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*",
        "elasticloadbalancing:Describe*",
        "iam:Get*",
        "iam:List*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "s3:ListAllMyBuckets",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyHandBuiltLiveDeployment",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:elasticbeanstalk:*:*:application/humanlikebot",
        "arn:aws:elasticbeanstalk:*:*:environment/humanlikebot/*",
        "arn:aws:elasticbeanstalk:*:*:applicationversion/humanlikebot/*",
        "arn:aws:rds:*:*:db:awseb-e-*",
        "arn:aws:rds:*:*:snapshot:awseb-e-*",
        "arn:aws:cloudfront::*:distribution/E2Q6P4TGU4GOC",
        "arn:aws:cloudfront::*:distribution/E2XKRGQ6R0OG6W",
        "arn:aws:s3:::bot.wwbp.org",
        "arn:aws:s3:::bot.wwbp.org/*",
        "arn:aws:s3:::dev.bot.wwbp.org",
        "arn:aws:s3:::dev.bot.wwbp.org/*",
        "arn:aws:s3:::bot-avatar.wwbp.org",
        "arn:aws:s3:::bot-avatar.wwbp.org/*",
        "arn:aws:s3:::dev.bot-avatar.wwbp.org",
        "arn:aws:s3:::dev.bot-avatar.wwbp.org/*"
      ]
    }
  ]
}
