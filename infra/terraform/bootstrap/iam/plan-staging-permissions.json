{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>"
    },
    {
      "Sid": "ReadOwnStateFile",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>/<PREFIX>/staging/terraform.tfstate"
    },
    {
      "Sid": "ReadOwnBucketSettings",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccelerateConfiguration",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration"
      ],
      "Resource": "arn:aws:s3:::<PREFIX>-staging-*"
    },
    {
      "Sid": "DescribeStackResources",
      "Effect": "Allow",
      "Action": [
        "acm:Describe*",
        "acm:List*",
        "autoscaling:Describe*",
        "cloudformation:Describe*",
        "cloudformation:Get*",
        "cloudformation:List*",
        "cloudfront:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "ec2:Describe*",
        "elasticache:Describe*",
        "elasticache:ListTagsForResource",
        "elasticbeanstalk:Describe*",
        "elasticbeanstalk:List*",
        "elasticloadbalancing:Describe*",
        "iam:Get*",
        "iam:List*",
        "logs:Describe*",
        "rds:Describe*",
        "rds:ListTagsForResource",
        "s3:ListAllMyBuckets",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyHandBuiltLiveDeployment",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:elasticbeanstalk:*:*:*/humanlikebot",
        "arn:aws:elasticbeanstalk:*:*:*/humanlikebot/*",
        "arn:aws:rds:*:*:*:awseb-e-*",
        "arn:aws:cloudfront::*:distribution/E2Q6P4TGU4GOC",
        "arn:aws:cloudfront::*:distribution/E2XKRGQ6R0OG6W",
        "arn:aws:s3:::elasticbeanstalk-*/humanlikebot/*",
        "arn:aws:s3:::bot.wwbp.org*",
        "arn:aws:s3:::dev.bot.wwbp.org*",
        "arn:aws:s3:::bot-avatar.wwbp.org*",
        "arn:aws:s3:::dev.bot-avatar.wwbp.org*"
      ]
    },
    {
      "Sid": "DenyHandBuiltLiveEnvironmentResources",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/elasticbeanstalk:environment-name": [
            "humanlike-bot-development-env",
            "humanlikebot-env"
          ]
        }
      }
    },
    {
      "Sid": "DenyOidcProviderChanges",
      "Effect": "Deny",
      "Action": "iam:*OpenIDConnectProvider*",
      "Resource": "*"
    },
    {
      "Sid": "DenyOtherProductionNames",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::<PREFIX>-tfstate-<ACCOUNT_ID>/<PREFIX>/production/*",
        "arn:aws:s3:::<PREFIX>-production-*",
        "arn:aws:s3:::elasticbeanstalk-*/<PREFIX>-production/*",
        "arn:aws:rds:*:*:*:<PREFIX>-production-*",
        "arn:aws:elasticache:*:*:*:<PREFIX>-production-*",
        "arn:aws:elasticbeanstalk:*:*:*/<PREFIX>-production",
        "arn:aws:elasticbeanstalk:*:*:*/<PREFIX>-production/*",
        "arn:aws:iam::*:*/<PREFIX>-production-*",
        "arn:aws:logs:*:*:log-group:/aws/elasticbeanstalk/<PREFIX>-production-*",
        "arn:aws:ssm:*:*:parameter/<PREFIX>-production/*",
        "arn:aws:secretsmanager:*:*:secret:<PREFIX>-production/*"
      ]
    },
    {
      "Sid": "DenyOtherProductionTags",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "production"
        }
      }
    }
  ]
}
