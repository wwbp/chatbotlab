# -----------------------------------------------------------------------------
# Bootstrap — run this ONCE before anything else.
#
# I create an S3 bucket to store Terraform state remotely so every deploy
# reads and writes the same source of truth.
#
# The bucket is named <project_name>-tfstate-<account id>, the same name the
# Deploy Infrastructure workflow creates and looks for, so a local run and the
# workflow always share one bucket.
#
# After `terraform apply` here, a file called backend.hcl is written to the
# terraform/ directory above. It names the bucket and region. The state key is
# not in it: it contains the environment, so setup.sh passes it at init time.
# You never commit backend.hcl to git.
# -----------------------------------------------------------------------------

terraform {
  required_version = ">= 1.11"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.4"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

variable "aws_region" {
  type    = string
  default = "us-east-1"
}

# No default on purpose: this prefixes the Terraform state bucket, which names
# live AWS infrastructure. setup.sh passes the value from terraform.tfvars and
# the CI workflows pass it from the TF_PROJECT_PREFIX secret.
variable "project_name" {
  type = string
}

data "aws_caller_identity" "current" {}

resource "aws_s3_bucket" "terraform_state" {
  bucket = "${var.project_name}-tfstate-${data.aws_caller_identity.current.account_id}"

  lifecycle {
    prevent_destroy = true
  }

  tags = {
    Project   = var.project_name
    Purpose   = "terraform-state"
    ManagedBy = "terraform-bootstrap"
  }
}

resource "aws_s3_bucket_versioning" "terraform_state" {
  bucket = aws_s3_bucket.terraform_state.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "terraform_state" {
  bucket = aws_s3_bucket.terraform_state.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "terraform_state" {
  bucket                  = aws_s3_bucket.terraform_state.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "local_file" "backend_config" {
  filename        = "${path.module}/../backend.hcl"
  file_permission = "0600"

  content = <<-EOT
    # Generated by terraform/bootstrap — do not edit by hand.
    bucket  = "${aws_s3_bucket.terraform_state.bucket}"
    region  = "${var.aws_region}"
    encrypt = true
  EOT
}

output "state_bucket_name" {
  value = aws_s3_bucket.terraform_state.bucket
}
