# -----------------------------------------------------------------------------
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in every value.
# NEVER commit terraform.tfvars to git — it contains secrets.
#
# The Django secret key is auto-generated and kept in Terraform state — you
# only set it below if you want to pin a specific value.
# -----------------------------------------------------------------------------

# Which environment am I deploying?
# Allowed values: "test" or "production"
environment = "test"

# The AWS region where I deploy everything.
# All resources (EB, RDS, ElastiCache, S3, CloudFront) land here.
aws_region = "us-east-1"

# A short name that prefixes every AWS resource I create.
# Changing this after first deploy would recreate everything, so pick once and keep it.
project_name = "REPLACE_with_your_resource_prefix"  # must match the TF_PROJECT_PREFIX secret; prefixes every AWS resource

# -----------------------------------------------------------------------
# Secrets. The API keys, Django's SECRET_KEY and the survey token are not
# set here: they go in the Secrets Manager secret <project_name>-<environment>/app,
# which an administrator creates and fills before the first apply
# (docs/deployment/technical-reference.rst, "Secrets"). RDS generates and
# keeps the database password. Neither ever enters Terraform state.
# -----------------------------------------------------------------------

# Test stack only: the password of the "admin" superuser the app creates in
# its empty database (production ignores it). It is kept in Terraform state.
admin_panel_password = "REPLACE_with_admin_panel_password"

# -----------------------------------------------------------------------
# GitHub — used to create an IAM role that GitHub Actions can assume
# via OIDC (no long-lived AWS access keys stored in GitHub secrets)
# -----------------------------------------------------------------------

# The GitHub organization or username that owns this repository
github_org = "wwbp"

# The repository name (without the org prefix)
github_repo = "chatbotlab"

# -----------------------------------------------------------------------
# Instance sizing — safe to leave as defaults for the test stack
# -----------------------------------------------------------------------

# EC2 instance type for the Elastic Beanstalk application servers
eb_instance_type = "t3.small"

# RDS instance class for the MySQL database
db_instance_class = "db.t3.micro"

# Maximum number of app servers the auto-scaling group may launch
eb_max_instances = 1

# -----------------------------------------------------------------------------
# Email — staff invites and password resets (optional)
# Leave these out for a stack that sends no email. Before you switch to the
# SES backend, verify the sender in Amazon SES by hand: see README, "Email".
# -----------------------------------------------------------------------------

# site_url           = "https://chatbot.mylab.org"
# email_backend      = "chatbot.email_backend.SESBackend"
# default_from_email = "ChatbotLab <no-reply@mylab.org>"
